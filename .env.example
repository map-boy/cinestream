# TMDB API key - required. Get one free at themoviedb.org (Settings > API).
VITE_TMDB_API_KEY=

# Google AdSense publisher ID, e.g. ca-pub-XXXXXXXXXXXXXXXX.
# Must match the entry in public/ads.txt. If unset, the value hardcoded in
# vite.config.ts is used so the ad snippet is never missing from the build.
VITE_ADSENSE_CLIENT_ID=ca-pub-6727162627172885

# Optional secondary ad networks. Leave blank to keep their scripts out of the
# build entirely (recommended while an AdSense site review is pending).
VITE_INFOLINKS_PUB_ID=
VITE_MEDIANET_SITE_ID=
VITE_MEDIANET_CID=
